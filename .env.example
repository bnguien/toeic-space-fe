# Public browser configuration. Never put credentials or signing keys in VITE_* variables.
# Empty keeps browser API requests on the same origin, using Vite's proxy.
VITE_API_BASE_URL=

# Used when running Vite directly on the host. Docker Compose overrides this with
# DOCKER_API_GATEWAY_URL so API traffic stays on the gateway's Docker network.
VITE_DEV_PROXY_TARGET=http://localhost:5050

# Public Docker-only settings. Start the Backend Compose stack first.
# Change the network name if your Backend Compose project has a different name.
DOCKER_API_GATEWAY_URL=http://api-gateway:8080
DOCKER_GATEWAY_NETWORK=toeic-space-be_frontend-network

# Optional public avatar CDN origin. This is unrelated to retained practice media.
VITE_AVATAR_CDN_URL=
