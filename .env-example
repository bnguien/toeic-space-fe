# Leave empty to call the API on the same origin (recommended).
# `npm run dev` proxies /identity and /assessment to VITE_DEV_PROXY_TARGET.
VITE_API_BASE_URL=

# API gateway used by the development proxy (http://host.docker.internal:5050 inside Docker).
VITE_DEV_PROXY_TARGET=http://localhost:5050

# Optional CDN or public asset domain for uploaded avatars (e.g. https://cdn.example.com).
# Leave empty to infer the public URL automatically from the presigned upload URL.
VITE_AVATAR_CDN_URL=
